# ─────────────────────────────────────────────────────────────────────────────
# Nezuko grammY Bot — systemd service unit
#
# Installation:
#   sudo cp nezuko-grammy.service /etc/systemd/system/
#   sudo systemctl daemon-reload
#   sudo systemctl enable nezuko-grammy
#   sudo systemctl start nezuko-grammy
#
# File locations (must match GitHub secrets):
#   Bot files  → /opt/nezuko/grammy/
#   Env file   → /etc/nezuko/grammy.env
#
# The env file (/etc/nezuko/grammy.env) must be:
#   - owned by root:nezuko, mode 640
#   - NOT committed to source control
#
# Logs:
#   journalctl -u nezuko-grammy -f
#   journalctl -u nezuko-grammy --since "1 hour ago"
# ─────────────────────────────────────────────────────────────────────────────
[Unit]
Description=Nezuko Telegram Bot — grammY Runtime
Documentation=https://github.com/mohdakil2426/Nezuko-Telegram-Bot
After=network-online.target redis.service
Wants=network-online.target
# Ensure Redis is available before bot starts (Redis may not be a hard dep
# but the bot degrades gracefully, so we only Wants= rather than Requires=).
Wants=redis.service

[Service]
# ── Identity ──────────────────────────────────────────────────────────────────
Type=simple
User=nezuko
Group=nezuko

# ── Working directory and environment ─────────────────────────────────────────
WorkingDirectory=/opt/nezuko/grammy
EnvironmentFile=/etc/nezuko/grammy.env

# ── Start command ─────────────────────────────────────────────────────────────
# Runs the compiled ESM bundle with Node.js 22.
# If Bun is installed on the Droplet, replace with:
#   ExecStart=/home/nezuko/.bun/bin/bun run /opt/nezuko/grammy/dist/main.js
ExecStart=/usr/bin/node /opt/nezuko/grammy/dist/main.js

# ── Stop behaviour ────────────────────────────────────────────────────────────
# SIGTERM triggers graceful shutdown (SIGINT/SIGTERM handler in shutdown.ts).
# Give the bot up to 30 seconds to cleanly finish in-flight requests.
KillSignal=SIGTERM
TimeoutStopSec=30

# ── Restart policy ────────────────────────────────────────────────────────────
# Restart on crash (exit code ≠ 0), but NOT on clean exits (e.g. SIGTERM).
Restart=on-failure
RestartSec=5
# Avoid restart storms — back off if the service keeps crashing.
StartLimitIntervalSec=60
StartLimitBurst=5

# ── Resource limits ───────────────────────────────────────────────────────────
# Prevent OOM on a 1 GB Droplet. The bot typically uses < 150 MB.
MemoryLimit=512M
# Limit open file descriptors (long polling + Redis + realtime WS).
LimitNOFILE=65536

# ── Security hardening ────────────────────────────────────────────────────────
# Restrict what the process can do even if it's compromised.
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
# Allow the bot to write to its own directory and log dir.
ReadWritePaths=/opt/nezuko/grammy
ProtectHome=true
CapabilityBoundingSet=
AmbientCapabilities=

# ── Logging ───────────────────────────────────────────────────────────────────
# Bot uses pino JSON logger. journald captures stdout/stderr.
StandardOutput=journal
StandardError=journal
SyslogIdentifier=nezuko-grammy

[Install]
WantedBy=multi-user.target
