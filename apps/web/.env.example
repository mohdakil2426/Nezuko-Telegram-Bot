# ============================================================
# Nezuko Web Dashboard - Environment Configuration
# ============================================================
# SETUP STEPS:
# 1. Copy this file: cp .env.example .env.local
# 2. Fill in your InsForge Base URL and Anon Key
# ============================================================

# ==========================================================
# INSFORGE BAAS CONNECTION (Required)
# ==========================================================
# Your InsForge backend URL (from InsForge dashboard)
NEXT_PUBLIC_INSFORGE_BASE_URL=
# Your InsForge anon key (from InsForge dashboard or get-anon-key MCP tool)
NEXT_PUBLIC_INSFORGE_ANON_KEY=
#
# Optional but recommended for local server actions and dev bypass mode.
# Server-only key used for privileged writes when no user token is available.
INSFORGE_SERVICE_KEY=

# ==========================================================
# MOCK DATA
# ==========================================================
# Use mock data instead of real InsForge data (for UI development without backend)
NEXT_PUBLIC_USE_MOCK=false

# ==========================================================
# DEVELOPMENT AUTH BYPASS
# ==========================================================
# Set to true to skip InsForge auth locally (shows "Skip Login" button).
# ⚠️  Must be false in production deployments.
NEXT_PUBLIC_DEV_LOGIN=false
