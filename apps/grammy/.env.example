# ────────────────────────────────────────────────────────────────
# Nezuko grammY Bot — Environment Variables
# Copy to .env and fill in values
# ────────────────────────────────────────────────────────────────

# ── Required ──────────────────────────────────────────────────
# Telegram bot token from @BotFather
BOT_TOKEN=

# InsForge backend URL (e.g., https://your-app.region.insforge.app)
INSFORGE_BASE_URL=

# InsForge anonymous JWT key (from backend metadata)
INSFORGE_ANON_KEY=

# ── Optional (with defaults) ─────────────────────────────────
# Redis connection URL (default: redis://localhost:6379)
# REDIS_URL=redis://localhost:6379

# Log level: debug | info | warn | error (default: info)
# LOG_LEVEL=info

# HTTP health endpoint port (default: 8080)
# HEALTH_PORT=8080

# Enable multi-bot dashboard mode (default: false)
# DASHBOARD_MODE=false

# AES-256-GCM master key for token decryption (required in DASHBOARD_MODE)
# MASTER_KEY=
