# ══════════════════════════════════════════════════════════════════
# Nezuko grammY Bot — Environment Variables Template
# ══════════════════════════════════════════════════════════════════
# 1. Copy this file:  copy .env.example .env
# 2. Fill in the required values below.
# ⚠  NEVER commit .env to git — it is in .gitignore.
# ══════════════════════════════════════════════════════════════════

# ── Bot Mode ──────────────────────────────────────────────────────
# true  = Dashboard Mode (multi-bot)
#           Reads active bot tokens from the `bot_instances` DB table.
#           Requires: INSFORGE_BASE_URL, INSFORGE_ANON_KEY, MASTER_KEY.
#           BOT_TOKEN is IGNORED in this mode.
#
# false = Standalone Mode (single bot) — DEFAULT, best for local dev/testing
#           Uses BOT_TOKEN below directly.
#           INSFORGE creds optional — starts with DB-disabled warning if missing.
DASHBOARD_MODE=false

# ── Telegram Token (standalone mode only) ─────────────────────────
# Get your token from @BotFather on Telegram: https://t.me/BotFather
# Ignored when DASHBOARD_MODE=true.
BOT_TOKEN=

# ── InsForge BaaS ─────────────────────────────────────────────────
# Powers: verification logs, status heartbeat, member sync,
#         member/channel counts, dashboard charts, command worker.
#
# Standalone mode: OPTIONAL — bot runs in degraded mode without these.
# Dashboard mode:  REQUIRED — fatal error if missing.
#
# Same values as apps/web/.env.local.
# Get them from: Dashboard → Settings → Backend Info
INSFORGE_BASE_URL=
INSFORGE_ANON_KEY=

# ── Master Encryption Key (dashboard mode only) ───────────────────
# Required when DASHBOARD_MODE=true for AES-256-GCM token decryption.
# Generate: web dashboard → Settings → Security Vault → Copy master key
# MASTER_KEY=

# ── Redis ─────────────────────────────────────────────────────────
# Powers: L1 chat-members cache, L2 verification cache (6h TTL),
#         per-user rate limiting, command debounce.
#
# Start local Redis:
#   docker compose -f docker-compose.local.yml up -d   (from project root)
#
# Default: redis://localhost:6379 (uses DB 0)
# REDIS_URL=redis://localhost:6379

# ── Logging ───────────────────────────────────────────────────────
# debug | info | warn | error   (default: info)
# LOG_LEVEL=info

# ── Health Check ─────────────────────────────────────────────────
# HTTP endpoint: GET http://localhost:8080/health → {"status":"ok","uptime":N}
# HEALTH_PORT=8080

# ── Keep-Alive Self-Ping ──────────────────────────────────────────
# Prevents the bot process from being killed due to inactivity on free-tier
# cloud hosts (Render, Railway, Fly.io) or when running on a local machine
# that enters sleep/hibernate.
#
# How it works: the bot GETs KEEP_ALIVE_URL every KEEP_ALIVE_INTERVAL_MS
# milliseconds, keeping the process marked as active to the host platform.
#
# Set to the public /health endpoint of THIS bot:
#   KEEP_ALIVE_URL=https://nezuko-bot.onrender.com/health
#
# Tune the interval based on your host's idle timeout:
#   Render free tier  → spin-down after 15 min → use 480000  (8 min)
#   Railway free tier → spin-down after 10 min → use 360000  (6 min)
#   Fly.io free tier  → no spin-down           → can disable
#   VPS / local dev   → leave blank (disabled)
#
# Leave KEEP_ALIVE_URL blank (default) to disable the loop entirely.
# KEEP_ALIVE_URL=
# KEEP_ALIVE_INTERVAL_MS=600000
