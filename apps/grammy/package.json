{
  "name": "nezuko-grammy-bot",
  "version": "1.1.0",
  "description": "Nezuko Telegram Bot — grammY TypeScript rebuild",
  "type": "module",
  "main": "dist/main.js",
  "scripts": {
    "dev": "bun run --watch src/main.ts",
    "build": "bun x tsc -p tsconfig.build.json",
    "start": "bun run dist/main.js",
    "type-check": "bun x tsc --noEmit",
    "lint": "bun x eslint src/ --max-warnings 0",
    "format": "bun x prettier src/ tests/ --write",
    "format:check": "bun x prettier src/ tests/ --check",
    "test": "bun test tests/",
    "test:watch": "bun test tests/ --watch",
    "test:coverage": "bun test tests/ --coverage",
    "knip": "bun x knip"
  },
  "dependencies": {
    "@grammyjs/auto-retry": "2.0.2",
    "@grammyjs/chat-members": "1.2.0",
    "@grammyjs/commands": "1.3.2",
    "@grammyjs/conversations": "^2.1.1",
    "@grammyjs/hydrate": "1.6.0",
    "@grammyjs/menu": "^1.3.1",
    "@grammyjs/ratelimiter": "1.2.1",
    "@grammyjs/runner": "2.0.3",
    "@grammyjs/transformer-throttler": "^1.2.1",
    "@roziscoding/grammy-autoquote": "^2.0.9",
    "dotenv": "^17.3.1",
    "grammy": "1.42.0",
    "ioredis": "5.10.1",
    "pino": "10.3.1",
    "pino-pretty": "^13.1.3",
    "socket.io-client": "4.8.3",
    "zod": "4.3.6"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/bun": "latest",
    "@types/node": "25.5.2",
    "@typescript-eslint/eslint-plugin": "^8.57.0",
    "@typescript-eslint/parser": "^8.57.0",
    "eslint": "10.2.0",
    "knip": "^5.86.0",
    "prettier": "^3.8.1",
    "typescript": "5.9.3"
  },
  "engines": {
    "bun": ">=1.0.0"
  }
}
