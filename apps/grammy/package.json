{
  "name": "nezuko-grammy-bot",
  "version": "1.0.0",
  "description": "Nezuko Telegram Bot — grammY TypeScript rebuild",
  "type": "module",
  "main": "dist/main.js",
  "scripts": {
    "dev": "bun run --watch src/main.ts",
    "build": "tsc -p tsconfig.build.json",
    "start": "node dist/main.js",
    "type-check": "tsc --noEmit",
    "lint": "eslint src/ --max-warnings 0",
    "format": "prettier src/ ../../tests/grammy --write",
    "format:check": "prettier src/ ../../tests/grammy --check",
    "test": "vitest run",
    "test:watch": "vitest watch",
    "test:coverage": "vitest run --coverage"
  },
  "dependencies": {
    "@grammyjs/auto-retry": "2.0.2",
    "@grammyjs/chat-members": "1.2.0",
    "@grammyjs/commands": "1.3.2",
    "@grammyjs/hydrate": "1.6.0",
    "@grammyjs/parse-mode": "^2.2.1",
    "@grammyjs/ratelimiter": "1.2.1",
    "@grammyjs/runner": "2.0.3",
    "@sentry/node": "10.41.0",
    "dotenv": "^17.3.1",
    "grammy": "1.41.1",
    "ioredis": "5.10.0",
    "pino": "10.3.1",
    "socket.io-client": "4.8.3",
    "zod": "4.3.6"
  },
  "devDependencies": {
    "@types/node": "22.15.0",
    "@typescript-eslint/eslint-plugin": "8",
    "@typescript-eslint/parser": "8",
    "@vitest/coverage-v8": "4.0.18",
    "eslint": "9.28.0",
    "pino-pretty": "13.0.0",
    "prettier": "^3.8.1",
    "typescript": "5.9.3",
    "vitest": "4.0.18"
  },
  "engines": {
    "node": ">=22.0.0"
  }
}
