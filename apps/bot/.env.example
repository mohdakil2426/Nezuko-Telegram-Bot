# ==========================================================================
# Nezuko Telegram Bot — Environment Template
# ==========================================================================
# Copy to .env: cp .env.example .env
# Then fill in your actual values.
#
# TWO OPERATING MODES:
#   Standalone Mode : Set BOT_TOKEN below — bot runs one instance from .env
#   Dashboard Mode  : Leave BOT_TOKEN empty — bot reads active bots from DB
# ==========================================================================

# ── Telegram ──────────────────────────────────────────────────────────────
# Token from @BotFather → /newbot
BOT_TOKEN=

# ── Environment ───────────────────────────────────────────────────────────
ENVIRONMENT=development       # development | production

# ── InsForge PostgreSQL (SQLAlchemy asyncpg — bot ORM) ────────────────────
# Used by core bot handlers, CRUD operations, verification logging.
# ⚠️  asyncpg requires ssl="require" in connect_args — NOT in the URL string.
# Get connection string: InsForge Dashboard → Project Settings → Database
DATABASE_URL=postgresql+asyncpg://postgres:<PASSWORD>@db.u4ckbciy.us-west.insforge.app:5432/insforge

# ── InsForge PostgreSQL (direct asyncpg — StatusWriter & CommandWorker) ───
# Used for real-time bot_status heartbeat and admin_commands polling.
# Same credentials as DATABASE_URL, but plain driver (no SQLAlchemy prefix).
INSFORGE_DATABASE_URL=postgresql://postgres:<PASSWORD>@db.u4ckbciy.us-west.insforge.app:5432/insforge

# ── Encryption ────────────────────────────────────────────────────────────
# Fernet key for encrypting/decrypting bot tokens stored in InsForge DB.
# Generate: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
ENCRYPTION_KEY=

# ── Redis (optional, recommended for production) ──────────────────────────
# Local dev: start with docker compose -f docker-compose.local.yml up -d
REDIS_URL=redis://127.0.0.1:6379/0

# ── Logging ───────────────────────────────────────────────────────────────
LOG_LEVEL=DEBUG               # DEBUG | INFO | WARNING | ERROR

# ── Webhook (production only) ─────────────────────────────────────────────
# Leave empty in development — bot will use polling automatically.
WEBHOOK_URL=
WEBHOOK_SECRET=
PORT=8443

# ── Observability (optional) ──────────────────────────────────────────────
SENTRY_DSN=
