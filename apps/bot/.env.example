# ==========================================================================
# Nezuko Telegram Bot — Environment Template
# ==========================================================================
# Copy to .env: cp .env.example .env
# Then fill in your actual values.
#
# TWO OPERATING MODES:
#   Dashboard Mode  : DASHBOARD_MODE=true  → reads active bots from InsForge
#                     DB (multi-bot). Default. Requires ENCRYPTION_KEY.
#   Standalone Mode : DASHBOARD_MODE=false → uses BOT_TOKEN below (single bot,
#                     for dev/testing).
# ==========================================================================

# ── Bot Mode ──────────────────────────────────────────────────────────────
# true  = Dashboard mode (multi-bot from InsForge DB) — recommended
# false = Standalone mode (single bot from BOT_TOKEN) — for dev/testing
DASHBOARD_MODE=true

# ── Telegram (standalone mode only) ──────────────────────────────────────
# Token from @BotFather → /newbot. Only used when DASHBOARD_MODE=false.
BOT_TOKEN=

# ── Environment ───────────────────────────────────────────────────────────
ENVIRONMENT=development       # development | production

# ── InsForge BaaS (REST API — all DB operations) ──────────────────────────
# Get from: InsForge Dashboard → Project Settings
INSFORGE_BASE_URL=https://<project-id>.<region>.insforge.app
INSFORGE_ANON_KEY=

# ── Database (test-only) ──────────────────────────────────────────────────
# Leave empty. Tests use SQLite in-memory automatically.
DATABASE_URL=

# ── Encryption ────────────────────────────────────────────────────────────
# Fernet key for decrypting bot tokens from InsForge DB (dashboard mode).
# Generate: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
ENCRYPTION_KEY=

# ── Redis (optional, recommended for production) ──────────────────────────
# Local dev: start with docker compose -f docker-compose.local.yml up -d
REDIS_URL=redis://127.0.0.1:6379/0

# ── Logging ───────────────────────────────────────────────────────────────
LOG_LEVEL=DEBUG               # DEBUG | INFO | WARNING | ERROR

# ── Webhook (production only) ─────────────────────────────────────────────
# Leave empty in development — bot will use polling automatically.
WEBHOOK_URL=
WEBHOOK_SECRET=
PORT=8443

# ── Observability (optional) ──────────────────────────────────────────────
SENTRY_DSN=
