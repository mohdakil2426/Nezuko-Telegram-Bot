# ==========================================================================
# Nezuko Platform — Root Environment Reference
# ==========================================================================
# ⚠️  This file is for DOCUMENTATION ONLY — do not put actual values here.
#
# Each service has its own environment file:
#   • apps/bot/.env        → Telegram Bot (copy from apps/bot/.env.example)
#   • apps/web/.env.local  → Next.js Dashboard (copy from apps/web/.env.example)
# ==========================================================================

# ==========================================================================
# APPS/BOT (.env)                      Telegram Bot
# ==========================================================================

BOT_TOKEN=                      # Token from @BotFather → /newbot

ENVIRONMENT=development         # development | production

# InsForge PostgreSQL (SQLAlchemy asyncpg — bot ORM)
# ⚠️  asyncpg: use ssl="require" in connect_args, NOT in URL
DATABASE_URL=postgresql+asyncpg://postgres:<PASSWORD>@db.u4ckbciy.us-west.insforge.app:5432/insforge

# InsForge PostgreSQL (direct asyncpg — StatusWriter & CommandWorker)
INSFORGE_DATABASE_URL=postgresql://postgres:<PASSWORD>@db.u4ckbciy.us-west.insforge.app:5432/insforge

# Fernet key for bot token encryption
# Generate: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
ENCRYPTION_KEY=

# Redis cache (local: docker compose -f docker-compose.local.yml up -d)
REDIS_URL=redis://127.0.0.1:6379/0

LOG_LEVEL=DEBUG                 # DEBUG | INFO | WARNING | ERROR

# Webhook (production only — leave empty for development polling)
WEBHOOK_URL=
WEBHOOK_SECRET=
PORT=8443

SENTRY_DSN=                     # Optional Sentry error tracking


# ==========================================================================
# APPS/WEB (.env.local)               Next.js Dashboard
# ==========================================================================

# InsForge BaaS connection (required)
NEXT_PUBLIC_INSFORGE_BASE_URL=https://u4ckbciy.us-west.insforge.app
NEXT_PUBLIC_INSFORGE_ANON_KEY=  # From InsForge Dashboard or get-anon-key MCP tool

# Your Telegram bot username (without @) — used for login widget
NEXT_PUBLIC_LOGIN_BOT_USERNAME=

# Dev helpers (set true for local development)
NEXT_PUBLIC_DEV_LOGIN=false     # true = show "Skip Login" button
NEXT_PUBLIC_USE_MOCK=false      # true = use mock data instead of real DB


# ==========================================================================
# DOCKER (docker-compose.local.yml)   Local Redis only
# ==========================================================================

# Redis (no configuration needed — uses defaults in compose file)


# ==========================================================================
# QUICK SETUP GUIDE
# ==========================================================================
#
#  1. Install dependencies:
#       nezuko setup          (Windows)
#       ./nezuko.sh setup     (Mac/Linux)
#
#  2. Fill in apps/bot/.env:
#       - BOT_TOKEN           from @BotFather
#       - DATABASE_URL        from InsForge Dashboard → Database → Connection
#       - INSFORGE_DATABASE_URL  same credentials, plain asyncpg driver
#       - ENCRYPTION_KEY      generate with Fernet command above
#
#  3. Fill in apps/web/.env.local:
#       - NEXT_PUBLIC_INSFORGE_ANON_KEY   from InsForge Dashboard
#       - NEXT_PUBLIC_LOGIN_BOT_USERNAME  your bot username
#
#  4. Start local Redis:
#       docker compose -f docker-compose.local.yml up -d
#
#  5. Start development services:
#       nezuko dev            (Windows)
#       ./nezuko.sh dev       (Mac/Linux)
# ==========================================================================
